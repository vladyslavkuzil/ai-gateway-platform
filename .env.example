# ---------------------------------------------------------------------------
# AI Gateway Platform — local development placeholders only
# Copy to .env and replace values. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (one server, many databases / least-privilege users)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me

INFERENCE_DB=inference_db
INFERENCE_DB_USER=inference
INFERENCE_DB_PASSWORD=change-me

IDENTITY_DB=identity_db
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=change-me

TENANT_DB=tenant_db
TENANT_DB_USER=tenant
TENANT_DB_PASSWORD=change-me

POLICY_DB=policy_db
POLICY_DB_USER=policy
POLICY_DB_PASSWORD=change-me

CATALOG_DB=catalog_db
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=change-me

BUDGET_DB=budget_db
BUDGET_DB_USER=budget
BUDGET_DB_PASSWORD=change-me

PROVIDER_DB=provider_db
PROVIDER_DB_USER=provider
PROVIDER_DB_PASSWORD=change-me

NOTIFICATION_DB=notification_db
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=change-me

ANALYTICS_DB=analytics_db
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=change-me

AUDIT_DB=audit_db
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=change-me

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Identity / bootstrap
KEY_HASH_PEPPER=change-me-to-a-long-random-string
BOOTSTRAP_ADMIN_TOKEN=change-me

# Service URLs (Compose DNS or localhost ports)
API_GATEWAY_PORT=8080
INFERENCE_SERVICE_URL=http://localhost:8083
IDENTITY_SERVICE_URL=http://localhost:8084
TENANT_SERVICE_URL=http://localhost:8085
POLICY_SERVICE_URL=http://localhost:8086
MODEL_CATALOG_SERVICE_URL=http://localhost:8087
BUDGET_LEDGER_SERVICE_URL=http://localhost:8088
PROVIDER_SERVICE_URL=http://localhost:8089
NOTIFICATION_SERVICE_URL=http://localhost:8091
ANALYTICS_SERVICE_URL=http://localhost:8082
AUDIT_SERVICE_URL=http://localhost:8092
MOCK_PROVIDER_BASE_URL=http://localhost:8081

# External LLM providers (disabled by default for local mock path)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_ENABLED=false
ANTHROPIC_ENABLED=false

# Local analytics journal path (Compose may also use analytics_db)
ANALYTICS_JOURNAL_PATH=./var/analytics-journal

# Notifications
WEBHOOK_URL=http://localhost:8090/hook